- content_for :page_title do
  = t('verification.verification')

- content_for :heading do
  %h1= t('settings.profile')
  = render partial: 'settings/shared/profile_navigation'

= render partial: 'settings/shared/profile_new_notice'

.simple_form.form-section
  %h2.heading-medium= t('verification.website_verification')

  %p.lead= t('verification.hint_html')

  %h3.heading-small= t('verification.here_is_how')

  %p.lead= t('verification.instructions_html')

  .input-copy.lead
    .input-copy__wrapper
      = copyable_input value: link_to('Mastodon', ActivityPub::TagManager.instance.url_for(@account), rel: :me)
    %button.button{ type: :button }= t('generic.copy')

  %p.lead= t('verification.extra_instructions_html')

  - if @verified_links.any?
    %h3.heading-small= t('verification.verified_links')

    %ul.lead
      - @verified_links.each do |field|
        %li
          %span.verified-badge
            = material_symbol 'check', { class: 'verified-badge__mark' }
            %span= field.value

.simple_form.form-section
  %h2.heading-medium Automatic verification

  %p.lead
    The rel="me" protocol verifies websites and profiles you want to be known by. Identity makes this easier and extends to social or blog sites that don’t support HTML editing.

  - if @truanon[:configured] == false
    %p.lead A server administrator must add the TruAnon service name and key before this can be used.
  - elsif @truanon[:disabled]
    %p.lead Automatic verification is currently turned off on this server.
  - else
    - if @truanon[:error]
      - if @truanon[:error_code] == 'service_inactive'
        %p.lead This server’s TruAnon service is currently disabled. A server administrator needs to enable it before verification will work.
      - else
        %p.lead TruAnon is unreachable right now — your current status is unchanged. Try again shortly.
    - elsif @truanon[:anchored]
      - ta_href = @truanon_public_profile_url.to_s.match?(%r{\Ahttps?://}i) ? @truanon_public_profile_url : "https://#{@truanon_public_profile_url}"
      .fields-group
        .input-copy
          .input-copy__wrapper
            %input{ type: 'text', maxlength: 999, spellcheck: false, readonly: true, value: 'Your identity has been securely assigned.' }
          - if @truanon_public_profile_url.present?
            = link_to @truanon_public_profile_url.sub(%r{\Ahttps?://}i, ''), ta_href, class: 'button', target: '_blank', rel: 'noopener'

      = simple_form_for current_user, url: settings_verification_path, html: { method: :put, id: :edit_truanon } do |tf|
        = tf.simple_fields_for :settings, current_user.settings do |ff|
          .fields-group
            = ff.input :wants_verified_identity, wrapper: :with_label, label: 'Use verified identity', hint: 'Off returns you to Unknown. Your anchor remains yours.'

          %h3.heading-small Privacy

          .fields-group
            = ff.input :show_personal, wrapper: :with_label, label: 'Display personal info'
            = ff.input :show_contact, wrapper: :with_label, label: 'Display contact details'
            = ff.input :show_social, wrapper: :with_label, label: 'Display social profiles'

          .fields-group
            = ff.input :make_private, wrapper: :with_label, label: 'Private mode (no links)', hint: 'Your rank shows, but nothing links out.'

        .actions
          = tf.button :button, t('generic.save_changes'), type: :submit
    - elsif @truanon_verify_url.present?
      .fields-group
        .input-copy
          .input-copy__wrapper
            %input{ type: 'text', maxlength: 999, spellcheck: false, readonly: true, value: 'Securely assign ownership only once' }
          %button.button{ type: 'button', data: { truanon_verify: @truanon_verify_url } } Verify
      %p.lead
        Once this profile is securely anchored, your rank along with any details you choose to share, travel with you across the fediverse — you control what is visible, your badge makes you trusted.

= simple_form_for @account, url: settings_verification_path, html: { class: 'form-section' } do |f|
  = render 'shared/error_messages', object: @account

  %h2.heading-medium= t('author_attribution.title')

  %p.lead= t('author_attribution.hint_html')

  .fields-group.fade-out-top
    %div
      .status-card.expanded.bottomless
        .status-card__image
          = image_tag frontend_asset_url('images/preview.png'), alt: '', class: 'status-card__image-image'
        .status-card__content
          %span.status-card__host
            %span= t('author_attribution.s_blog', name: display_name(@account))
            ·
            %time.time-ago{ datetime: 1.year.ago.to_date.iso8601 }
          %strong.status-card__title= t('author_attribution.example_title')
      .more-from-author
        = logo_as_symbol(:icon)
        = t('author_attribution.more_from_html', name: author_attribution_name(@account))

  %h3.heading-small= t('verification.here_is_how')

  %p.lead= t('author_attribution.instructions')

  .input-copy.lead
    .input-copy__wrapper
      = copyable_input value: tag.meta(name: 'fediverse:creator', content: "@#{@account.local_username_and_domain}")
    %button.button{ type: :button }= t('generic.copy')

  %p.lead= t('author_attribution.then_instructions')

  .fields-group
    = f.input :attribution_domains,
              as: :text,
              input_html: { value: @account.attribution_domains.join("\n"), placeholder: "example1.com\nexample2.com\nexample3.com", rows: 4, autocapitalize: 'none', autocorrect: 'off' },
              wrapper: :with_block_label

  .actions
    = f.button :button, t('generic.save_changes'), type: :submit
